DATABASE_URL=postgresql://civileu:civileu@localhost:5432/civileu
SECRET_KEY=replace-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
OPENCAGE_API_KEY=
GEOCODING_PROVIDER=opencage
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPPORTUNITY_KIND_CLASSIFIER_MODEL=gpt-5.4-nano
OPPORTUNITY_KIND_CLASSIFIER_MIN_CONFIDENCE=0.75
OPPORTUNITY_DEDUPLICATION_EMBEDDING_MODEL=text-embedding-3-small
IMPORT_SCHEDULER_POLL_SECONDS=60
IMPORT_HEALTH_GRACE_SECONDS=21600
# Optional on macOS/Homebrew; leave empty in the container.
GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib
