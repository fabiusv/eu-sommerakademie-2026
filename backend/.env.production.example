# Copy to .env.production, replace every placeholder, and never commit it.
CIVILEU_IMAGE=civileu:latest
CIVILEU_DATABASE_PLATFORM=linux/amd64

POSTGRES_DB=civileu
POSTGRES_USER=civileu
POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTAINER_DATABASE_URL=postgresql://civileu:replace-with-a-long-random-password@db:5432/civileu

SECRET_KEY=replace-with-a-generated-django-secret
DEBUG=false
ALLOWED_HOSTS=api.example.org
CSRF_TRUSTED_ORIGINS=https://app.example.org,https://api.example.org
CORS_ALLOWED_ORIGINS=https://app.example.org
SESSION_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600

OPENCAGE_API_KEY=replace-with-opencage-key
GEOCODING_PROVIDER=opencage
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_API_URL=https://api.openai.com/v1
OPPORTUNITY_KIND_CLASSIFIER_MODEL=gpt-5.4-nano
OPPORTUNITY_KIND_CLASSIFIER_MIN_CONFIDENCE=0.75
OPPORTUNITY_DEDUPLICATION_EMBEDDING_MODEL=text-embedding-3-small
IMPORT_SCHEDULER_POLL_SECONDS=60
IMPORT_HEALTH_GRACE_SECONDS=21600

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
HEALTHCHECK_HOST=api.example.org
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT_SECONDS=60
